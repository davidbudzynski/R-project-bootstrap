# R history and session files
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/

# Example code in package build process
*-Ex.R

# Output files from R CMD build / check
/*.tar.gz
/*.Rcheck/

# knitr and R Markdown default cache directories
*_cache/
/cache/

# Temporary files created by R Markdown
*.utf8.md
*.knit.md

# Environment files
.env
.Renviron

# OAuth token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# renv (if a project library is used outside the container)
renv/library/
renv/local/
renv/cache/
renv.lock.lock

# Quarto
.quarto/

# Generated output (regenerable from code; only .gitkeep is tracked)
output/data/*
!output/data/.gitkeep
output/plots/*
!output/plots/.gitkeep
output/reports/*
!output/reports/.gitkeep

# Compressed docker image archives
*.tar.zst

# Editors and OS
.idea/
.DS_Store
*.swp
*~